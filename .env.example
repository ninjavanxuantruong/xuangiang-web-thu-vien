# ===== Google Sheet =====
# Link CSV publish của sheet tài liệu chính (type, name, url, summaryD/E/F, faceLink, NguonTrang)
PDF_SHEET_URL=
# Link CSV publish của sheet "Bài đọc đề xuất" (2 cột: name, link) — TÁCH
# RIÊNG khỏi sheet tài liệu chính
SUGGESTED_SHEET_URL=

CHIBO_SHEET_URL=

# Link CSV publish của sheet danh sách đảng viên (đọc theo vị trí cột:
# A=STT đảng bộ | B=STT chi bộ | C=họ tên | D=chi bộ | E=chức vụ).
# Tên chi bộ ở cột D phải khớp tên trong sheet CHIBO_SHEET_URL (bỏ qua hoa/thường, dấu, "CB"/"Chi bộ").
DANGVIEN_SHEET_URL=

# Link CSV publish của sheet Danh nhân & Địa điểm (ten, link, anh1, anh2, anh3, anh4)
NHANVAT_SHEET_URL=

# ===== Firebase (Firestore) =====
# Lấy từ Firebase Console > Project Settings > Service Accounts > Generate new private key
# QUAN TRỌNG: nhớ thu hồi key cũ đã lộ trên GitHub trước khi tạo key mới ở đây.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nNỘI DUNG KEY CỦA BẠN\n-----END PRIVATE KEY-----\n"

# ===== Khu quản lý (Ban Xây dựng Đảng) =====
ADMIN_PASSWORD=

# ===== Session =====
# Chuỗi bí mật bất kỳ, càng dài/ngẫu nhiên càng tốt, dùng để mã hoá cookie phiên
SESSION_SECRET=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai

# ===== Server =====
PORT=3000
