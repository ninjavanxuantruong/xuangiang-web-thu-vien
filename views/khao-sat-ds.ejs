<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Khảo sát — Thư viện Đảng bộ Xuân Giang</title>
  <link rel="stylesheet" href="/public/style.css" />
  <style>
    .ks-wrap { max-width: 760px; margin: 0 auto; padding: 24px 16px 60px; }
    .ks-wrap h1 { font-size: 1.25em; margin: 0 0 6px; }
    .ks-intro { color: var(--text-secondary); font-size: 14px; margin: 0 0 18px; }
    .ks-ds { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
    .ks-ds a {
      display: flex; align-items: center; gap: 14px;
      padding: 16px; border-radius: var(--radius-md);
      border: 1px solid var(--border-color); border-left: 4px solid var(--color-brand);
      background: var(--bg-surface); color: inherit; text-decoration: none;
    }
    .ks-ds a:hover { background: var(--bg-surface-2); }
    .ks-ds a:focus-visible { outline: 2px solid var(--color-gold); outline-offset: 2px; }
    .ks-ds .ten { font-weight: 700; font-size: 15px; line-height: 1.45; }
    .ks-ds .phu { font-size: 13px; color: var(--text-muted); margin-top: 4px; }
    .ks-ds .nut { margin-left: auto; flex: none; background: var(--color-brand); color: #fff; font-size: 13px; padding: 8px 16px; border-radius: 999px; }
  </style>
</head>
<body>
  <header class="site-header">
    <a href="/" style="display:flex;align-items:center;gap:12px;color:#fff;">
      <div class="logo">★</div>
      <div>
        <div class="title">Thư viện Đảng bộ Xuân Giang</div>
        <div class="subtitle">Khảo sát</div>
      </div>
    </a>
    <div class="spacer"></div>
    <button class="account-btn" data-toggle-theme>🌙 Tối</button>
  </header>

  <main class="ks-wrap">
    <h1>Khảo sát</h1>
    <p class="ks-intro">Chọn bài khảo sát để làm.</p>
    <ul class="ks-ds">
      <% ds.forEach(function (b) { %>
        <li>
          <a href="/khao-sat/<%= b.dot %>">
            <div>
              <div class="ten"><%= b.ten %></div>
              <div class="phu"><%= b.soCau %> câu · đạt từ <%= b.nguong %>%</div>
            </div>
            <span class="nut">Làm bài →</span>
          </a>
        </li>
      <% }) %>
    </ul>
  </main>

  <footer class="site-footer">
    <a href="/">← Về trang chính</a>
  </footer>
  <script src="/public/main.js"></script>
  <%- include("partials/xung-danh") %>
</body>
</html>
