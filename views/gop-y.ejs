<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Góp ý — Thư viện Đảng bộ Xuân Giang</title>
  <link rel="stylesheet" href="/public/style.css" />
  <style>
    .feedback-wrap { max-width: 560px; margin: 0 auto; padding: 24px 16px 60px; }
    .feedback-wrap label { display: block; font-size: 13px; font-weight: 600; margin: 14px 0 6px; }
    .feedback-wrap input[type="text"],
    .feedback-wrap textarea {
      width: 100%;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid var(--border-color);
      background: var(--bg-page);
      color: var(--text-primary);
      font-size: 14px;
      font-family: inherit;
    }
    .feedback-wrap textarea { min-height: 140px; resize: vertical; }
    .feedback-note {
      background: var(--bg-surface-2);
      border-radius: var(--radius-md);
      padding: 12px 14px;
      font-size: 12px;
      color: var(--text-secondary);
      margin-top: 16px;
      line-height: 1.6;
    }
    .feedback-success {
      background: #eaf5ec;
      color: #2f7d4f;
      border-radius: var(--radius-md);
      padding: 14px;
      font-size: 13px;
      margin-bottom: 16px;
    }
    .feedback-error {
      background: #fdeaea;
      color: var(--color-brand);
      border-radius: var(--radius-md);
      padding: 12px 14px;
      font-size: 13px;
      margin-bottom: 12px;
    }
    .feedback-locked-note {
      background: var(--bg-surface-2);
      border-radius: var(--radius-md);
      padding: 12px 14px;
      font-size: 13px;
      color: var(--text-secondary);
      margin-bottom: 16px;
    }
    .captcha-row { display: flex; align-items: center; gap: 10px; margin-top: 14px; }
    .captcha-row input { width: 80px; flex: none; }
    .btn-pill:disabled { opacity: 0.5; cursor: not-allowed; }

    /* Khối khảo sát — chỉ hiện khi có dữ liệu trong sheet khảo sát */
    .survey-section { margin-top: 32px; padding-top: 20px; border-top: 1px solid var(--border-color); }
    .survey-section h2 { font-size: 1em; margin: 0 0 10px; }
    .survey-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
    .survey-link {
      display: block;
      padding: 12px 14px;
      border-radius: var(--radius-md);
      background: var(--bg-surface-2);
      color: var(--text-primary);
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
    }
    .survey-link:hover { background: var(--bg-surface-3, var(--bg-surface-2)); }
    .survey-link::after { content: " →"; opacity: 0.6; }
  </style>
</head>
<body>

  <header class="site-header">
    <a href="/" style="display:flex;align-items:center;gap:12px;color:#fff;">
      <div class="logo">★</div>
      <div>
        <div class="title">Thư viện Đảng bộ Xuân Giang</div>
        <div class="subtitle">Góp ý của nhân dân</div>
      </div>
    </a>
    <div class="spacer"></div>
    <button class="account-btn" data-toggle-theme>🌙 Tối</button>
  </header>

  <div class="feedback-wrap">
    <h1 style="font-size:1.2em;">Gửi góp ý</h1>

    <% if (success) { %>
      <div class="feedback-success">✓ Cảm ơn bạn, góp ý đã được gửi tới Ban Xây dựng Đảng.</div>
    <% } %>
    <% if (error) { %>
      <div class="feedback-error"><%= error %></div>
    <% } %>
    <% if (locked && !success) { %>
      <div class="feedback-locked-note">Bạn đã gửi góp ý hôm nay. Mời quay lại vào ngày mai.</div>
    <% } %>

    <form method="POST" action="/gop-y">
      <label for="hoTen">Họ tên</label>
      <input type="text" id="hoTen" name="hoTen" placeholder="Họ và tên" <%= locked ? "disabled" : "" %> />

      <label for="diaChi">Địa chỉ</label>
      <input type="text" id="diaChi" name="diaChi" placeholder="Thôn/xóm, xã..." <%= locked ? "disabled" : "" %> />

      <label for="noiDung">Nội dung góp ý *</label>
      <textarea id="noiDung" name="noiDung" placeholder="Nhập ý kiến của bạn..." required <%= locked ? "disabled" : "" %>></textarea>

      <div class="captcha-row">
        <label style="margin:0;">Xác nhận: <%= a %> + <%= b %> = </label>
        <input type="text" name="dapAn" inputmode="numeric" required <%= locked ? "disabled" : "" %> />
      </div>

      <button type="submit" class="btn-pill" style="margin-top:16px;" <%= locked ? "disabled" : "" %>>Gửi góp ý</button>
    </form>

    <div class="feedback-note">
      Đây là kênh góp ý xây dựng để Ban Xây dựng Đảng tham khảo, <strong>không phải kênh khiếu nại — tố cáo chính thức</strong>.
      Nếu bạn cần khiếu nại, tố cáo, vui lòng liên hệ trực tiếp UBND/bộ phận tiếp công dân theo quy định.
    </div>

    <% if (surveys && surveys.length > 0) { %>
      <div class="survey-section">
        <h2>Khảo sát</h2>
        <ul class="survey-list">
          <% surveys.forEach(function(s) { %>
            <li><a class="survey-link" href="<%= s.link %>" target="_blank" rel="noopener"><%= s.name %></a></li>
          <% }); %>
        </ul>
      </div>
    <% } %>
  </div>

  <footer class="site-footer">
    <a href="/">← Về trang chính</a>
  </footer>

  <script src="/public/main.js"></script>
</body>
</html>