<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Khu vực của tôi — Thư viện Đảng bộ Xuân Giang</title>
  <link rel="stylesheet" href="/public/style.css" />
  <style>
    .me-card { background: var(--card-bg, #fff); border: 1px solid var(--border, #e5d5d5); border-radius: 12px; padding: 20px; margin-bottom: 20px; display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
    .me-avatar { width: 56px; height: 56px; border-radius: 50%; background: var(--color-brand, #a52424); color: #fff; font-size: 26px; display: flex; align-items: center; justify-content: center; }
    .me-name { font-size: 20px; font-weight: 700; }
    .me-sub { color: var(--text-muted, #777); font-size: 14px; margin-top: 2px; }
    .me-stat { margin-left: auto; text-align: center; }
    .me-stat b { display: block; font-size: 28px; color: var(--color-brand, #a52424); }
    .read-list { list-style: none; padding: 0; margin: 0; }
    .read-item { display: flex; justify-content: space-between; gap: 12px; align-items: center; padding: 12px 14px; border: 1px solid var(--border, #e5d5d5); border-radius: 10px; margin-bottom: 8px; background: var(--card-bg, #fff); }
    .read-item a { font-weight: 600; color: inherit; flex: 1; }
    .read-item a:hover { color: var(--color-brand, #a52424); }
    .read-meta { font-size: 12px; color: var(--text-muted, #777); white-space: nowrap; text-align: right; }
  </style>
</head>
<body>

  <header class="site-header">
    <a href="/" style="display:flex;align-items:center;gap:12px;color:#fff;">
      <div class="logo">★</div>
      <div>
        <div class="title">Thư viện Đảng bộ Xuân Giang</div>
        <div class="subtitle">Khu vực của tôi</div>
      </div>
    </a>
    <div class="spacer"></div>
    <a href="/" class="account-btn" style="text-decoration:none;">← Trang chủ</a>
    <button class="account-btn" data-toggle-theme>🌙 Tối</button>
  </header>

  <div class="section">
    <div class="me-card">
      <div class="me-avatar">👤</div>
      <div>
        <div class="me-name"><%= me.name %></div>
        <div class="me-sub">Chi bộ: <%= me.chiBoName || me.chiBoId %></div>
      </div>
      <div class="me-stat"><b><%= reads.length %></b><span class="me-sub">văn bản đã đọc</span></div>
    </div>

    <div class="section-title">Các văn bản đã đọc</div>

    <% if (reads.length === 0) { %>
      <p style="color:var(--text-muted);font-size:13px;">Bạn chưa đọc văn bản nào kể từ khi xưng danh. Mở một tài liệu bất kỳ, nó sẽ hiện ở đây.</p>
    <% } else { %>
      <ul class="read-list">
        <% reads.forEach(function(r) { %>
          <li class="read-item">
            <a href="/doc/<%= encodeURIComponent(r.docName) %>">📄 <%= r.docName %></a>
            <div class="read-meta">
              <%= r.lanCuoi ? new Date(r.lanCuoi).toLocaleDateString("vi-VN", { timeZone: "Asia/Ho_Chi_Minh" }) : "" %>
              <% if (r.soLan > 1) { %><br>đọc <%= r.soLan %> ngày<% } %>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>

  <script src="/public/main.js"></script>
</body>
</html>
