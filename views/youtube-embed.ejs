<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= name %></title>
  <link rel="stylesheet" href="/public/style.css" />
</head>
<body>

  <div class="reader-toolbar">
    <button data-toggle-theme>🌙 Tối</button>
    <a href="/" style="margin-left:auto;font-size:12px;color:var(--text-muted);">← Trang chính</a>
  </div>

  <div class="reader-content" style="max-width:760px;">
    <h1 style="font-size:1.3em;margin-bottom:16px;"><%= name %></h1>

    <div style="position:relative;padding-top:56.25%;border-radius:var(--radius-md);overflow:hidden;box-shadow:var(--shadow-card);">
      <iframe
        src="<%= link %>"
        style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;"
        allow="autoplay; encrypted-media"
        allowfullscreen
      ></iframe>
    </div>
  </div>

  <script src="/public/main.js"></script>
</body>
</html>
