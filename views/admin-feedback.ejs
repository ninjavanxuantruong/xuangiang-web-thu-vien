<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Quản lý Góp ý — Khu quản lý</title>
  <link rel="stylesheet" href="/public/style.css" />
  <style>
    .toolbar-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      margin-bottom: 16px;
    }
    .toolbar-row input[type="month"],
    .toolbar-row input[type="text"] {
      padding: 8px 10px;
      border-radius: 8px;
      border: 1px solid var(--border-color);
      background: var(--bg-page);
      color: var(--text-primary);
      font-size: 13px;
    }
    .toolbar-row button, .toolbar-row a.btn {
      background: var(--text-primary);
      color: var(--bg-page);
      border: none;
      border-radius: 6px;
      padding: 8px 14px;
      font-size: 12px;
      cursor: pointer;
      text-decoration: none;
    }
    .toolbar-row .danger { background: var(--color-brand); }
    .feedback-table-wrap {
      overflow-x: auto;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      background: var(--bg-surface);
    }
    table.feedback-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    table.feedback-table th,
    table.feedback-table td {
      padding: 10px 12px;
      border-bottom: 1px solid var(--border-color);
      text-align: left;
      vertical-align: top;
    }
    table.feedback-table th {
      background: var(--bg-page);
      font-size: 11.5px;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.03em;
      white-space: nowrap;
    }
    table.feedback-table td.col-thoigian { white-space: nowrap; color: var(--text-muted); font-size: 12px; }
    table.feedback-table td.col-hoten { white-space: nowrap; }
    table.feedback-table td.col-diachi { white-space: nowrap; }
    table.feedback-table td.col-noidung { white-space: pre-wrap; line-height: 1.6; min-width: 260px; }
    table.feedback-table tr:last-child td { border-bottom: none; }
    .stat-summary {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-bottom: 20px;
    }
    .stat-box {
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 16px;
      text-align: center;
    }
    .stat-box .number {
      font-size: 26px;
      font-weight: 700;
      color: var(--color-brand);
    }
    .stat-box .label {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 4px;
    }
    .bar-chart {
      display: flex;
      align-items: flex-end;
      gap: 6px;
      height: 140px;
      border-bottom: 1px solid var(--border-color);
      padding: 0 4px;
    }
    .bar-chart .bar {
      flex: 1;
      background: var(--color-brand);
      border-radius: 3px 3px 0 0;
      min-height: 2px;
      position: relative;
    }
    .bar-chart .bar span {
      position: absolute;
      top: -18px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 9px;
      color: var(--text-muted);
      white-space: nowrap;
    }
    .month-labels {
      display: flex;
      gap: 6px;
      padding: 0 4px;
      margin-top: 6px;
    }
    .month-labels span {
      flex: 1;
      text-align: center;
      font-size: 9px;
      color: var(--text-muted);
    }
  </style>
</head>
<body>

  <header class="site-header">
    <div class="logo">★</div>
    <div>
      <div class="title">Khu quản lý</div>
      <div class="subtitle">Góp ý của nhân dân</div>
    </div>
    <div class="spacer"></div>
    <a href="/quanly/thong-ke" class="account-btn" style="margin-right:8px;">📊 Truy cập</a>
    <a href="/quanly/bo-nho-dem" class="account-btn" style="margin-right:8px;">🗂 Bộ nhớ đệm</a>
    <a href="/quanly/nguoi-doc" class="account-btn" style="margin-right:8px;">👥 Người đọc</a>
    <a href="/quanly/nhat-ky-loi" class="account-btn">🩺 Nhật ký lỗi</a>
  </header>

  <div class="section">
    <!-- ====== Thống kê góp ý theo năm (mới) ====== -->
    <form method="GET" action="/quanly/gop-y" class="toolbar-row">
      <input type="hidden" name="thang" value="<%= thang %>" />
      <input type="text" name="nam" value="<%= nam %>" placeholder="Năm, vd 2026" style="width:100px;" />
      <button type="submit">Xem thống kê năm</button>
    </form>

    <div class="section-title">Thống kê góp ý — Năm <%= nam %></div>
    <div class="stat-summary">
      <div class="stat-box">
        <div class="number"><%= totalNam || 0 %></div>
        <div class="label">Tổng góp ý cả năm <%= nam %></div>
      </div>
      <div class="stat-box">
        <div class="number"><%= (countByMonth && countByMonth[thang]) || 0 %></div>
        <div class="label">Góp ý tháng <%= thang %></div>
      </div>
    </div>

    <%
      const monthEntries = Array.from({ length: 12 }, (_, i) => {
        const key = `${nam}-${String(i + 1).padStart(2, "0")}`;
        return [key, (countByMonth && countByMonth[key]) || 0];
      });
      const maxMonthCount = Math.max(1, ...monthEntries.map(([, c]) => c));
    %>
    <div class="bar-chart">
      <% monthEntries.forEach(function([key, count]) { %>
        <div class="bar" style="height: <%= Math.round((count / maxMonthCount) * 100) %>%;">
          <span><%= count %></span>
        </div>
      <% }) %>
    </div>
    <div class="month-labels">
      <% monthEntries.forEach(function([key]) { %>
        <span>T<%= parseInt(key.slice(5), 10) %></span>
      <% }) %>
    </div>

    <!-- ====== Xem/xuất/xoá chi tiết theo tháng, xoá theo năm (đã có) ====== -->
    <div class="section-title" style="margin-top:28px;">Xem chi tiết theo tháng</div>
    <form method="GET" action="/quanly/gop-y" class="toolbar-row">
      <input type="month" name="thang" value="<%= thang %>" />
      <button type="submit">Xem</button>
      <a class="btn" href="/quanly/gop-y/xuat?thang=<%= thang %>">⬇ Xuất CSV tháng này</a>
    </form>

    <form method="POST" action="/quanly/gop-y/xoa" class="toolbar-row" onsubmit="return confirm('Xoá toàn bộ góp ý tháng ' + this.thang.value + '? Không thể hoàn tác.');">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="thang" value="<%= thang %>" />
      <button type="submit" class="danger">🗑 Xoá góp ý tháng <%= thang %></button>
    </form>

    <form method="POST" action="/quanly/gop-y/xoa" class="toolbar-row" onsubmit="return confirm('Xoá TOÀN BỘ góp ý năm ' + this.nam.value + '? Không thể hoàn tác.');">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="text" name="nam" placeholder="Năm, vd 2026" value="<%= nam %>" style="width:100px;" required />
      <button type="submit" class="danger">🗑 Xoá theo năm</button>
    </form>

    <div class="section-title">Góp ý tháng <%= thang %> (<%= items.length %>)</div>

    <% if (items.length === 0) { %>
      <p style="color:var(--text-muted);font-size:13px;">Chưa có góp ý nào trong tháng này.</p>
    <% } else { %>
      <div class="feedback-table-wrap">
        <table class="feedback-table">
          <thead>
            <tr>
              <th>Thời gian</th>
              <th>Họ tên</th>
              <th>Địa chỉ</th>
              <th>Nội dung</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(function(item) { %>
              <tr>
                <td class="col-thoigian">
                  <%= item.thoiGian ? new Date(item.thoiGian).toLocaleString("vi-VN") : "" %>
                </td>
                <td class="col-hoten"><%= item.hoTen || "Ẩn danh" %></td>
                <td class="col-diachi"><%= item.diaChi || "" %></td>
                <td class="col-noidung"><%= item.noiDung %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <footer class="site-footer">
    <a href="/">← Về trang chính</a>
    <a class="admin-link" href="/quanly/thoat">· Thoát</a>
  </footer>

</body>
</html>
